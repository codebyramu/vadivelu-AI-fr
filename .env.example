# Gemini API Keys (Configure 1 to N keys)
GEMINI_API_KEY_1=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
# GEMINI_API_KEY_6=

# Server Configuration
PORT=8000
HOST=0.0.0.0
GEMINI_MODEL=gemini-2.5-flash
ENVIRONMENT=development

# Voice & TTS Defaults
DEFAULT_VOICE_GENDER=female
DEFAULT_MALE_VOICE=en-US-ChristopherNeural
DEFAULT_FEMALE_VOICE=en-US-JennyNeural

# Database Path
DATABASE_URL=sqlite:///./backend/data/vadivelu.db
MEME_STORAGE_PATH=./backend/data/memes
